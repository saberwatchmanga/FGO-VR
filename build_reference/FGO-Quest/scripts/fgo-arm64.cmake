set(CMAKE_SYSTEM_NAME Linux)
set(CMAKE_SYSTEM_PROCESSOR aarch64)
get_filename_component(FGO_QUEST_ROOT "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
get_filename_component(FGO_WORK_ROOT "${FGO_QUEST_ROOT}/.." ABSOLUTE)
set(CMAKE_SYSROOT "${FGO_QUEST_ROOT}/tools/sysroot-arm64")
set(FGO_LLVM_BIN "${FGO_WORK_ROOT}/tools/llvm-21.1.8/bin")
set(CMAKE_C_COMPILER "${FGO_LLVM_BIN}/clang.exe")
set(CMAKE_CXX_COMPILER "${FGO_LLVM_BIN}/clang++.exe")
set(CMAKE_ASM_COMPILER "${FGO_LLVM_BIN}/clang.exe")
set(CMAKE_C_COMPILER_TARGET aarch64-linux-gnu)
set(CMAKE_CXX_COMPILER_TARGET aarch64-linux-gnu)
set(CMAKE_ASM_COMPILER_TARGET aarch64-linux-gnu)
set(CMAKE_C_FLAGS_INIT "--gcc-toolchain=${CMAKE_SYSROOT}/usr")
set(CMAKE_CXX_FLAGS_INIT "--gcc-toolchain=${CMAKE_SYSROOT}/usr")
set(CMAKE_EXE_LINKER_FLAGS_INIT "-fuse-ld=lld")
set(CMAKE_SHARED_LINKER_FLAGS_INIT "-fuse-ld=lld")
set(CMAKE_AR "${FGO_LLVM_BIN}/llvm-ar.exe" CACHE FILEPATH "")
set(CMAKE_RANLIB "${FGO_LLVM_BIN}/llvm-ranlib.exe" CACHE FILEPATH "")
set(CMAKE_NM "${FGO_LLVM_BIN}/llvm-nm.exe" CACHE FILEPATH "")
set(CMAKE_STRIP "${FGO_LLVM_BIN}/llvm-strip.exe" CACHE FILEPATH "")
set(CMAKE_OBJCOPY "${FGO_LLVM_BIN}/llvm-objcopy.exe" CACHE FILEPATH "")
set(CMAKE_OBJDUMP "${FGO_LLVM_BIN}/llvm-objdump.exe" CACHE FILEPATH "")
set(CMAKE_LINKER_TYPE LLD)
set(CMAKE_FIND_ROOT_PATH "${CMAKE_SYSROOT}")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
set(CMAKE_CROSSCOMPILING_EMULATOR "")

+MspaceStats Arena::Stats(std::size_t alignment) const {
+    std::lock_guard lock(mutex);
+    MspaceStats result{.base = base, .capacity = capacity,
+                       .allocation_count = allocations.size()};
+    for (const auto& [offset, size] : free_blocks) {
+        result.free += size;
+        const auto aligned = AlignUp(base + offset, alignment);
+        if (aligned && *aligned - (base + offset) < size) {
+            result.largest_aligned_block = std::max(
+                result.largest_aligned_block, size - (*aligned - (base + offset)));
+        }
+    }
+    result.used = capacity - result.free;
+    return result;
